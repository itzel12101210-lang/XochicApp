rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Prendas: solo usuarios autenticados pueden subir
    // Solo pueden leer sus propios archivos o cualquiera puede ver prendas
    match /prendas/{userId}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024  // max 10MB
                   && request.resource.contentType.matches("image/.*");
    }

    // Avatares de perfil
    match /avatares/{userId}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
