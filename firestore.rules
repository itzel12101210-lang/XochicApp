rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuarios: solo el propio usuario puede escribir su perfil
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Prendas: cualquier autenticado puede leer, solo el vendedor puede editar
    match /prendas/{prendaId} {
      allow read:  if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.vendedoraId
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"]));
      allow delete: if request.auth != null && request.auth.uid == resource.data.vendedoraId;
    }

    // Ordenes: privadas entre comprador y vendedor
    match /ordenes/{ordenId} {
      allow read:  if request.auth != null
                   && (request.auth.uid == resource.data.compradoraId
                       || request.auth.uid == resource.data.vendedoraId);
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.compradoraId
                        || request.auth.uid == resource.data.vendedoraId);
    }
  }
}
